{
  "name": "@erd-forge/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:grammar": "peggy --format es src/parsers/sdl/grammar.pegjs -o src/parsers/sdl/grammar.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "peggy": "^5.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@erd-forge/core": "workspace:*",
    "@erd-forge/lineage": "workspace:*",
    "@erd-forge/parser-sdl": "workspace:*",
    "@guanmingchiu/sqlparser-ts": "0.63.0",
    "@lezer/highlight": "^1.2.3",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@xyflow/react": "^12.11.6",
    "comlink": "^4.4.2",
    "elkjs": "0.12.0",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "immer": "^11.1.18",
    "lucide-react": "^1.44.0",
    "node-sql-parser": "^5.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  }
}
