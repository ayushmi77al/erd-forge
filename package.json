{
  "name": "erd-forge",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@erd-forge/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build:grammar": "turbo run build:grammar --filter=@erd-forge/web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.0.0"
}
